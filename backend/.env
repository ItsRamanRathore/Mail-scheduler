# ReachInbox Email Scheduler Environment Config

PORT=5000
NODE_ENV=development

# Redis Configuration (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SQLite / Database
DATABASE_URL=./data/scheduler.db
# PostgreSQL / MySQL connection string if using external DB:
# DATABASE_URL=postgres://user:password@localhost:5432/reachinbox

# Elasticsearch URL (Optional / Configurable)
ELASTICSEARCH_NODE=http://localhost:9200

# Concurrency & Rate Limiting (Configurable via ENV - no hardcoding!)
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Slack OAuth & Webhook
SLACK_CLIENT_ID=mock_slack_client_id
SLACK_CLIENT_SECRET=mock_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_WEBHOOK_URL=

# Google OAuth
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
